{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "dev.factorai",
	"productName": "qursor-ide",
	"version": "0.55.0",
	"build": {
		"beforeDevCommand": "pnpm vite:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm vite:build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"title": "Qursor IDE",
				"width": 1400,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"shortDescription": "Qursor IDE",
		"copyright": "© 2026 Titouan BENOIT and contributors",
		"longDescription": "Qursor IDE is a local agentic development environment. Supervise AI coding sessions, review their changes, and keep your work on your own machine.",
		"targets": [
			"app",
			"dmg",
			"appimage"
		],
		"macOS": {
			"hardenedRuntime": true
		},
		"linux": {
			"appimage": {
				"bundleMediaFramework": true
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"shell": {
			"open": "((mailto:|tel:)[\\w+][^\\s]*|https?://\\w[^\\s]*|/[\\w.][^\\n]*)"
		},
		"updater": {
			"endpoints": [
				"https://github.com/Nightbr/factorai/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1RTU1Q0I1MkVERkM3NjEKUldSaHg5OHV0VnpsaFJBRnRQZ1JFak4zSjJlQUVtZ0JKelRMWlVIcHpHQkhmbkxEZFozb2xKaksK"
		}
	}
}
